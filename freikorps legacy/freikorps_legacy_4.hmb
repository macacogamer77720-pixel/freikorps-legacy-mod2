    "localisation/spanish/country_germany_l_spanish.yml": "l_spanish:\nGER_democratic:5 \u0022Germany\u0022\r\nGER_democratic_DEF:5 \u0022The Germany\u0022\r\nGER_democratic_ADJ:5 \u0022Germany citizen\u0022\r\nGER_democratic_party:0 \u0022frente democr\u00E1tico \u0022\r\nGER_democratic_party_long:0 \u0022Frente democr\u00E1tico alem\u00E1n \u0022\r\nGER_neutrality:5 \u0022Germany\u0022\r\nGER_neutrality_DEF:5 \u0022The Germany\u0022\r\nGER_neutrality_ADJ:5 \u0022Germany citizen\u0022\r\nGER_neutrality_party:0 \u0022gobierno militar\u0022\r\nGER_neutrality_party_long:0 \u0022gobierno militar\u0022\r\nGER_paternal_autocrats:5 \u0022Germany\u0022\r\nGER_paternal_autocrats_DEF:5 \u0022The Germany\u0022\r\nGER_paternal_autocrats_ADJ:5 \u0022Germany citizen\u0022\r\nGER_paternal_autocrats_party:0 \u0022\u0022\r\nGER_paternal_autocrats_party_long:0 \u0022\u0022\r\nGER_nacional_socialismo:5 \u0022Germany\u0022\r\nGER_nacional_socialismo_DEF:5 \u0022The Germany\u0022\r\nGER_nacional_socialismo_ADJ:5 \u0022Germany citizen\u0022\r\nGER_nacional_socialismo_party:0 \u0022\u0022\r\nGER_nacional_socialismo_party_long:0 \u0022\u0022\r\n",
    "localisation/variables.yml": "l_english:\r\nsecure_the_baltic:\u0022The Baltic states have been a point of tension between us and the West, but looking at the political landscape, perhaps we could take control of them if we invest sufficient resources. Besides, it would certainly be a great boost to the morale and loyalty of our troops. Our current influence is [?baltic_influence] we\u0027ll need at least 100 to stage a coup.\u0022 \r\n",
    "music/music.asset": "\r\n# MAIN THEME\r\nmusic = {\r\n\tname = \u0022maintheme\u0022\r\n\tfile = \u0022wawtheme.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n# General Peace:\r\nmusic = {\r\n\tname = \u0022general_peace_1\u0022\r\n\tfile = \u0022general_peace_heartsofmen.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022general_peace_2\u0022\r\n\tfile = \u0022thewarends.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022general_peace_3\u0022\r\n\tfile = \u0022asongforthechildrenofww2.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n# General war:\r\nmusic = {\r\n\tname = \u0022general_war_1\u0022\r\n\tfile = \u0022general_war_bringforththetanks.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022general_war_2\u0022\r\n\tfile = \u0022general_war_theattack.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n\r\n# Allies Peace:\r\nmusic = {\r\n\tname = \u0022allies_peace_1\u0022\r\n\tfile = \u0022allies_peace_morningofdday.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022allies_peace_2\u0022\r\n\tfile = \u0022endofthetour.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022originalmaintheme\u0022\r\n\tfile = \u0022hoi4mainthemeallies.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n\r\n# Allies War:\r\nmusic = {\r\n\tname = \u0022allies_war_1\u0022\r\n\tfile = \u0022wearesoldiers.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022allies_war_2\u0022\r\n\tfile = \u0022allies_war_theroyalairforce.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n\r\n# Axis Peace:\r\nmusic = {\r\n\tname = \u0022axis_peace_1\u0022\r\n\tfile = \u0022axis_peace_krakow.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022axis_peace_2\u0022\r\n\tfile = \u0022luftwaffemarch_reprise.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n\r\n# Axis War:\r\nmusic = {\r\n\tname = \u0022axis_war_1\u0022\r\n\tfile = \u0022axistheme.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022axis_war_2\u0022\r\n\tfile = \u0022heavywater.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022axis_war_3\u0022\r\n\tfile = \u0022operationbarbarossa.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\nmusic = {\r\n\tname = \u0022axis_war_4\u0022\r\n\tfile = \u0022war_axis_1_daysofthunder.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n\r\n# Comintern Peace:\r\n\r\nmusic = {\r\n\tname = \u0022comintern_peace_1\u0022\r\n\tfile = \u0022motherrussia.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\nmusic = {\r\n\tname = \u0022comintern_peace_2\u0022\r\n\tfile = \u0022theredarmy.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\nmusic = {\r\n\tname = \u0022comintern_peace_3\u0022\r\n\tfile = \u0022sovietvictory.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\n# Comintern War:\r\n\r\nmusic = {\r\n\tname = \u0022comintern_war_1\u0022\r\n\tfile = \u0022themightofsovietunion.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\nmusic = {\r\n\tname = \u0022comintern_war_2\u0022\r\n\tfile = \u0022cominterntheme.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n\r\nmusic = {\r\n\tname = \u0022comintern_war_3\u0022\r\n\tfile = \u0022thegreatpatrioticwar.ogg\u0022\r\n\tvolume = 0.65\r\n}\r\n",
