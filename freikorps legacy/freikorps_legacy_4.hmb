    "events/events_for_focus_tree.txt": "add_namespace = events_for_focus_tree\r\n\r\n#Qu\u00E9 hacer con la poblaci\u00F3n?\r\ncountry_event = {\r\n\tid = events_for_focus_tree.1\r\n\ttitle = events_for_focus_tree.1.t\r\n\tdesc = events_for_focus_tree.1.d\r\n\r\n\tpicture = qu_hacer_con_la_poblacin-487\r\n\tfire_only_once = yes\r\n\ttrigger = {\r\n\t\thas_completed_focus = Qu\u00E9_hacer_con_la_poblaci\u00F3n?\r\n\r\n\r\n\t}\r\n\tmean_time_to_happen = { days = 1 }\r\n\ttimeout_days = 8\r\n\toption = {\r\n\t\tname = events_for_focus_tree.1.a\r\n\t\ttrigger = {\r\n\t\t\t\r\n\t\t}\r\n\t\tai_chance = { factor = 1 }\r\n\t\tcreate_unit = {\r\n\r\ndivision = \u0022name = \\\u0022[Low_freikorps]\\\u0022 division_template = \\\u0022[Low_Freikorps_units]\\\u0022 start_experience_factor = [0;1] start_equipment_factor = [0;1]\u0022\r\n\r\nowner = [Ger]\r\n\r\n}\r\n\r\n\r\n\t\thidden_effect = {\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n#un peque\u00F1o acercamiento?\r\ncountry_event = {\r\n\tid = events_for_focus_tree.2\r\n\ttitle = events_for_focus_tree.2.t\r\n\tdesc = events_for_focus_tree.2.d\r\n\r\n\tpicture = qu_hacer_con_la_poblacin-487\r\n\tfire_only_once = yes\r\n\ttrigger = {\r\n\t\thas_completed_focus = Qu\u00E9_hacer_con_la_poblaci\u00F3n?\r\n\r\n\r\n\t}\r\n\tmean_time_to_happen = { days = 1 }\r\n\ttimeout_days = 8\r\n\toption = {\r\n\t\tname = events_for_focus_tree.2.a\r\n\t\ttrigger = {\r\n\t\t\t\r\n\t\t}\r\n\t\tai_chance = { factor = 1 }\r\n\r\n\r\n\t\thidden_effect = {\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n#but they reform\r\ncountry_event = {\r\n\tid = events_for_focus_tree.3\r\n\ttitle = events_for_focus_tree.3.t\r\n\tdesc = events_for_focus_tree.3.d\r\n\r\n\tpicture = qu_hacer_con_la_poblacin-487\r\n\tfire_only_once = yes\r\n\ttrigger = {\r\n\t\thas_completed_focus = Qu\u00E9_hacer_con_la_poblaci\u00F3n?\r\n\r\n\r\n\t}\r\n\tmean_time_to_happen = { days = 1 }\r\n\ttimeout_days = 8\r\n\toption = {\r\n\t\tname = events_for_focus_tree.3.a\r\n\t\tadd_ideas = reformed_freikorps