    "common/scripted_guis/super_event.txt": "scripted_gui = {\t#\u0412\u0430\u0448 \u0441\u0443\u043F\u0435\u0440 \u0456\u0432\u0435\u043D\u0442 | Your super event#\r\n\r\n\tsuper_event_custom_window = { \r\n\t\tcontext_type = player_context\r\n\t\twindow_name = \u0022super_event_custom_window\u0022 #\u041D\u0430\u0437\u0432\u0430 \u043F\u043E\u0432\u0438\u043D\u043D\u0430 \u0437\u0431\u0456\u0433\u0430\u0442\u0438\u0441\u044C \u044F\u043A \u0456 \u0432 3-\u0439 \u0441\u0442\u0440\u043E\u0447\u0446\u0456 \u043A\u043E\u0434\u0443#\r\n\r\n\t\tvisible = {\r\n\t\t\thas_country_flag = superevent_has_began #\u0412\u0456\u043D \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0454 \u043F\u043E\u044F\u0432\u0443 \u0432\u0430\u0448\u043E\u0433\u043E \u0441\u0443\u043F\u0435\u0440 \u0456\u0432\u0435\u043D\u0442\u0443, \u0437\u043C\u0456\u043D\u044E\u0439\u0442\u0435 \u0441\u0430\u043C\u0443 \u043D\u0430\u0437\u0432\u0443 \u043F\u0456\u0441\u043B\u044F \u0022=\u0022#\r\n\t\t}\r\n\t}\r\n\r\n\tsuperevent_frame_se_custom = { #\u041D\u0410\u0414\u0417\u0412\u0418\u0427\u0410\u0419\u041D\u041E \u0412\u0410\u0416\u041B\u0418\u0412\u041E \u0429\u041E\u0411 \u0412\u041E\u041D\u041E \u0417\u0411\u0406\u0413\u0410\u041B\u041E\u0421\u042C \u0406\u0417 \u0422\u0412\u041E\u0407\u041C \u0421\u0423\u041F\u0415\u0420 \u0406\u0412\u0415\u041D\u0422\u041E\u041C \u0412 (\u043D\u0430\u0437\u0432\u0430).gui#\r\n\t\tcontext_type = player_context\r\n\t\twindow_name = \u0022superevent_frame_se_custom\u0022 #\u041D\u0430\u0437\u0432\u0430 \u043F\u043E\u0432\u0438\u043D\u043D\u0430 \u0437\u0431\u0456\u0433\u0430\u0442\u0438\u0441\u044C \u044F\u043A \u0456 \u0432 12-\u0439 \u0441\u0442\u0440\u043E\u0447\u0446\u0456 \u043A\u043E\u0434\u0443#\r\n\r\n\t\tvisible = {\r\n\t\t\thas_country_flag = superevent_has_began #\u041F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0441\u044F \u0449\u043E \u043D\u0430\u0437\u0432\u0438 \u0437\u0431\u0456\u0433\u0430\u044E\u0442\u044C\u0441\u044F#\r\n\t\t}\r\n\r\n\t\teffects = {\r\n\t\t\tOption_click = {\r\n\t\t\t\tclr_country_flag = superevent_has_began #\u043F\u0440\u0438\u0431\u0438\u0440\u0430\u0454 \u0442\u0432\u0456\u0439 \u0441\u0443\u043F\u0435\u0440 \u0456\u0432\u0435\u043D\u0442, \u043F\u0435\u0440\u0435\u0440\u0432\u0456\u0440\u044C \u0447\u0438 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0439\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430#\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n",
    "common/scripted_location/GER_factions_scripted_localisation.txt": "# Allows you to create your own dynamic keys\r\n# to be called in localization.\r\n# defined_text -\u003E this is it, we\u0027re defining the text\r\n# text -\u003E a discrete entry that can be picked to display in loc.\r\n# trigger -\u003E determines if a text entry will be picked or not.\r\n# (The triggers need to be valid for the scope the key is called in\r\n# (eg Root or From.From).)\r\n# localization_key -\u003E points to the localization key\r\n# that\u0027ll be used if trigger passes\r\n\r\ndefined_text = {\r\n\tname = GetStalinistsName\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\toriginal_tag = GER\r\n\t\t}\r\n\t\tlocalization_key = GER_stalinists_name_and_icon\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetNationalBolshevistsName\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\toriginal_tag = GER\r\n\t\t}\r\n\t\tlocalization_key = GER_national_bolshevists_name_and_icon\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetStrasseristsName\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\toriginal_tag = GER\r\n\t\t}\r\n\t\tlocalization_key = GER_strasserists_name_and_icon\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetOrthodoxCommunistsName\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\toriginal_tag = GER\r\n\t\t}\r\n\t\tlocalization_key = GER_orthodox_communists_name_and_icon\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetStalinistsStrengthStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_stalinists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_strength_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_stalinists_strength_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetNationalBolshevistsStrengthStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_national_bolshevists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_strength_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_national_bolshevists_strength_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetStrasseristsStrengthStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_strasserists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_strength_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_strasserists_strength_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetOrthodoxCommunistsStrengthStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_orthodox_communists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_strength_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_orthodox_communists_strength_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetStalinistsPopularityStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_stalinists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_popularity_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_stalinists_popularity_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetNationalBolshevistsPopularityStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_national_bolshevists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_popularity_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_national_bolshevists_popularity_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetStrasseristsPopularityStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_strasserists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_popularity_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_strasserists_popularity_status_amount\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetOrthodoxCommunistsPopularityStatus\r\n\ttext = {\r\n\t\ttrigger = {\r\n\t\t\thas_country_flag = GER_orthodox_communists_imprisonned_flag\r\n\t\t}\r\n\t\tlocalization_key = GER_popularity_status_imprisonned\r\n\t}\r\n\ttext = {\r\n\t\tlocalization_key = GER_orthodox_communists_popularity_status_amount\r\n\t}\r\n}\r\n\r\n\r\ndefined_text = {\r\n\tname = GetInternalFactionName\r\n\ttext = {\r\n\t\tlocalization_key = \u0022[?GER.faction_name_array^i.GetTokenLocalizedKey]\u0022\r\n\t}\r\n\r\n}\r\ndefined_text = {\r\n\tname = GetInternalFactionNameAndIcon\r\n\ttext = {\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^i.GetTokenLocalizedKey]  [?GER.faction_name_array^i.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\ndefined_text = {\r\n\tname = DECISIONSSCOPE_GetInternalFactionNameAndIcon\r\n\ttext = {\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.selected_faction.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.selected_faction.GetTokenLocalizedKey]\u0022\r\n\t}\r\n\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetInternalFactionLeaderPortrait\r\n\ttext = {\r\n\t\tlocalization_key = \u0022[?GER.faction_leader_gfx_array^i.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\ndefined_text = {\r\n\tname = GetInternalFactionLogo\r\n\ttext = {\r\n\t\tlocalization_key = \u0022[?GER.faction_overlay_gfx_array^i.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetFactionToBeBolstered\r\n\ttext={\r\n\t\ttrigger = { has_variable = GER.faction_to_bolster }\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.faction_to_bolster.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.faction_to_bolster.GetTokenLocalizedKey]\u0022\r\n\t}\r\n\ttext={\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.selected_faction.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.selected_faction.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\n\r\n#Discredit faction decision unavailable but might as well keep this in\r\ndefined_text = {\r\n\tname = GetFactionToBeDiscredited\r\n\ttext={\r\n\t\ttrigger = { has_variable = GER.faction_to_discredit  }\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.faction_to_discredit.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.faction_to_discredit.GetTokenLocalizedKey]\u0022\r\n\t}\r\n\ttext={\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.selected_faction.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.selected_faction.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetFactionToGiveSpeech\r\n\ttext={\r\n\t\ttrigger = { has_variable = GER.faction_speech  }\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.faction_speech.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.faction_speech.GetTokenLocalizedKey]\u0022\r\n\t}\r\n\ttext={\r\n\t\tlocalization_key = \u0022[?GER.faction_symbol_array^GER.selected_faction.GetTokenLocalizedKey]  [?GER.faction_name_array^GER.selected_faction.GetTokenLocalizedKey]\u0022\r\n\t}\r\n}\r\n\r\n\r\ndefined_text = {\r\n\tname = GetGERFactionTT\r\n\ttext={\r\n\t\ttrigger = { NOT = { GER_faction_power_struggle_is_over = yes } }\r\n\t\tlocalization_key = \u0022GER_faction_tt\u0022\r\n\t}\r\n\ttext={\r\n\t\tlocalization_key = \u0022GER_faction_tt_2\u0022\r\n\t}\r\n}\r\n\r\ndefined_text = {\r\n\tname = GetGERFactionText\r\n\ttext={\r\n\t\ttrigger = { NOT = { GER_faction_power_struggle_is_over = yes } }\r\n\t\tlocalization_key = \u0022faction_text\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 0 } has_idea = GER_FACTION_EFFECTS_STALINISTS_NEGATIVE }\r\n\t\tlocalization_key = \u0022GER_STALINISTS_EFFECTS_NEGATIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 0 } has_idea = GER_FACTION_EFFECTS_STALINISTS_POSITIVE }\r\n\t\tlocalization_key = \u0022GER_STALINISTS_EFFECTS_POSITIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 1 } has_idea = GER_FACTION_EFFECTS_ORTHODOX_COMMUNISTS_NEGATIVE }\r\n\t\tlocalization_key = \u0022GER_ORTHODOX_COMMUNISTS_EFFECTS_NEGATIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 1 } has_idea = GER_FACTION_EFFECTS_ORTHODOX_COMMUNISTS_POSITIVE }\r\n\t\tlocalization_key = \u0022GER_ORTHODOX_COMMUNISTS_EFFECTS_POSITIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 2 } has_idea = GER_FACTION_EFFECTS_NATIONAL_BOLSHEVISTS_NEGATIVE }\r\n\t\tlocalization_key = \u0022GER_NATIONAL_BOLSHEVISTS_EFFECTS_NEGATIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 2 } has_idea = GER_FACTION_EFFECTS_NATIONAL_BOLSHEVISTS_POSITIVE }\r\n\t\tlocalization_key = \u0022GER_NATIONAL_BOLSHEVISTS_EFFECTS_POSITIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 3 } has_idea = GER_FACTION_EFFECTS_STRASSERISTS_NEGATIVE }\r\n\t\tlocalization_key = \u0022GER_STRASSERISTS_EFFECTS_NEGATIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\ttrigger = { check_variable = { i = 3 } has_idea = GER_FACTION_EFFECTS_STRASSERISTS_POSITIVE }\r\n\t\tlocalization_key = \u0022GER_STRASSERISTS_EFFECTS_POSITIVE_TT\u0022\r\n\t}\r\n\ttext={\r\n\t\tlocalization_key = \u0022GER_FACTION_NEUTRAL\u0022\r\n\t}\r\n}\r\n",
    "common/scripted_triggers/GER_faction_scripted_triggers.txt": "GER_faction_power_struggle_is_over={\n\tOR = {\n\t\thas_completed_focus = GER_karl_radek_focus\n\t\thas_completed_focus = GER_ernstthalmann\n\t\thas_completed_focus = GER_focus_paetel\n\t\thas_completed_focus = GER_otto_strasser_focus\n\t}\n}\n\nGER_propaganda_poster_slot_available = {\n\tcustom_trigger_tooltip = {\n\t\ttooltip = SOV_propaganda_poster_slot_available_tt\n\t\tOR = {\n\t\t\tcheck_variable = { GER_poster_left_icon_frame = GER_propaganda_empty_slot_index }\n\t\t\tcheck_variable = { GER_poster_center_icon_frame = GER_propaganda_empty_slot_index }\n\t\t\tcheck_variable = { GER_poster_right_icon_frame = GER_propaganda_empty_slot_index }\n\t\t}\n\t}\n}\n\n\nGER_stalinists_in_power={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_stalinists_in_power_tt\n\t\tcheck_variable = { GER.faction_status_array^0 = token:GER_FACTION_STATUS_IN_GOV }\n\t}\n}\nGER_orthodox_communists_in_power={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_orthodox_communists_in_power_tt\n\t\tcheck_variable = { GER.faction_status_array^1 = token:GER_FACTION_STATUS_IN_GOV }\n\t}\n}\nGER_national_bolshevists_in_power={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_national_bolshevists_in_power_tt\n\t\tcheck_variable = { GER.faction_status_array^2 = token:GER_FACTION_STATUS_IN_GOV }\n\t}\n}\nGER_strasserists_in_power={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_strasserists_in_power_tt\n\t\tcheck_variable = { GER.faction_status_array^3 = token:GER_FACTION_STATUS_IN_GOV }\n\t}\n}\n\nGER_stalinists_are_friendly={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_stalinists_are_friendly_tt\n\t\tcheck_variable = { GER.faction_status_array^0 = token:GER_FACTION_STATUS_FRIENDLY }\n\t}\n}\nGER_orthodox_communists_are_friendly={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_orthodox_communists_are_friendly_tt\n\t\tcheck_variable = { GER.faction_status_array^1 = token:GER_FACTION_STATUS_FRIENDLY }\n\t}\n}\nGER_national_bolshevists_are_friendly={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_national_bolshevists_are_friendly_tt\n\t\tcheck_variable = { GER.faction_status_array^2 = token:GER_FACTION_STATUS_FRIENDLY }\n\t}\n}\nGER_strasserists_are_friendly={\n\tcustom_trigger_tooltip={\n\t\ttooltip = GER_strasserists_are_friendly_tt\n\t\tcheck_variable = { GER.faction_status_array^3 = token:GER_FACTION_STATUS_FRIENDLY }\n\t}\n}",
    "common/scripted_variables/ger_variables.txt": "hugenberg_support = 0\r\nludendorff_support = 0\r\nroehm_support = 0",
    "common/units/names_divisions/GER_1936_names_divisions.txt": "GER_DIV_0_0 = {\r\n\tname = \u0022Example Division\u0022\r\n\tfor_countries = { GER }\r\n\tcan_use = { always = yes }\r\n\tdivision_types = { \r\n\t\t\u0022infantry\u0022 \r\n\t}\r\n\tfallback_name = \u0022%d. Example Division\u0022\r\n}\r\n",
    "common/units/names_divisions/GER_1939_names_divisions.txt": "GER_DIV_0_1 = {\r\n\tname = \u0022Example Division\u0022\r\n\tfor_countries = { GER }\r\n\tcan_use = { always = yes }\r\n\tdivision_types = { \r\n\t\t\u0022infantry\u0022 \r\n\t}\r\n\tfallback_name = \u0022%d. Example Division\u0022\r\n}\r\n",
    "descriptor.mod": "version=\u00220.1\u0022\nreplace_path=\u0022gfx/loadingscreens\u0022\ntags={\n\t\u0022Alternative History\u0022\n}\nname=\u0022freikorps legacy 4\u0022\nsupported_version=\u00221.17.1.1\u0022",
    "events/conflictos_fronterizos_de_polonia.txt": "add_namespace = conflictos_fronterizos_de_polonia\r\n\r\n#nuestras tropas arrazan\r\ncountry_event = {\r\n\tid = conflictos_fronterizos_de_polonia.1\r\n\ttitle = conflictos_fronterizos_de_polonia.1.t\r\n\tdesc = conflictos_fronterizos_de_polonia.1.d\r\n\r\n\tpicture = nuestras_tropas_arrazan-1\r\n        fire_only_once = yes\r\n\tis_triggered_only = yes\r\n\ttrigger = {\r\n\t\thas_decision = ofensiva_fronteriza_en_gdyna\r\n\r\n\r\n\t}\r\n\toption = {\r\n\t\tname = conflictos_fronterizos_de_polonia.1.a\r\n\t\ttrigger = {\r\n\t\t\t\r\n\t\t}\r\n\t\tai_chance = { factor = 1 }\r\n\t\tGER = {\n transfer_state = 807\n}\n\n\n\r\n\t\thidden_effect = {\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n\r\n#nuestras tropas arrazan\r\ncountry_event = {\r\n\tid = conflictos_fronterizos_de_polonia.2\r\n\ttitle = conflictos_fronterizos_de_polonia.2.t\r\n\tdesc = conflictos_fronterizos_de_polonia.2.d\r\n\r\n\tpicture = vQFXETfp-1\r\n        fire_only_once = yes\r\n\tis_triggered_only = yes\r\n        trigger = {\r\n\t\thas_decision = ofensiva_fronteriza_en_posen\r\n\r\n\r\n\t}\r\n\toption = {\r\n\t\tname = conflictos_fronterizos_de_polonia.2.a\r\n\t\ttrigger = {\r\n\t\t\t\r\n\t\t}\r\n\t\tai_chance = { factor = 1 }\r\n\t\t\nGER = {\n transfer_state = 85\n}\n\n\n\n\r\n\t\thidden_effect = {\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n\r\n#nuestras tropas arrazan\r\ncountry_event = {\r\n\tid = conflictos_fronterizos_de_polonia.3\r\n\ttitle = conflictos_fronterizos_de_polonia.3.t\r\n\tdesc = conflictos_fronterizos_de_polonia.3.d\r\n\r\n\tpicture = jCwnGgyT-1\r\n        fire_only_once = yes\r\n\tis_triggered_only = yes\r\n        trigger = {\r\n\t\thas_decision = ofensiva_fronteriza_en_danzing\r\n\r\n\r\n\t}\r\n\toption = {\r\n\t\tname = conflictos_fronterizos_de_polonia.3.a\r\n\t\ttrigger = {\r\n\t\t\t\r\n\t\t}\r\n\t\tai_chance = { factor = 1 }\r\n\t\tGER = {\n transfer_state = 86\n}\r\n\t\thidden_effect = {\r\n\t\t\t\r\n\t\t}\r\n\t}\r\n}\r\n\r\n#nuestras trop